# =============================================================================
# Shared secret -- rendered once per namespace.
#
# Contains values common to ALL agents & workflows (LLM proxy, S3 defaults,
# Solace broker). Per-agent Secrets can override any key (K8s envFrom
# resolves later entries after earlier ones).
#
# Namespaces populated by render-secrets.sh:
#   sam-solace-lab-agents       (all external agents + core agents)
#   sam-solace-lab-workflows    (procurement workflow)
#
# Template rendered via:  make secrets
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  namespace: ${K8S_NAMESPACE}
  name: sam-shared-secret
type: Opaque
stringData:
  # --- SAM logical namespace (event addressing; NOT the K8s namespace) ---
  NAMESPACE: "sam-solace-lab"

  # --- LiteLLM proxy ---------------------------------------------------------
  LLM_SERVICE_ENDPOINT: "https://lite-llm.mymaas.net"
  LLM_SERVICE_API_KEY: "${LLM_SERVICE_API_KEY}"

  # --- Solace Event Broker ---------------------------------------------------
  SOLACE_BROKER_URL: "ws://host.docker.internal:8008"
  SOLACE_BROKER_VPN: "sam"
  SOLACE_BROKER_USERNAME: "default"
  SOLACE_BROKER_PASSWORD: "${SOLACE_BROKER_PASSWORD}"
  SOLACE_DEV_MODE: "false"

  # --- Artifact storage (SeaweedFS, S3-compatible) ---------------------------
  ARTIFACT_SERVICE_TYPE: "s3"
  S3_BUCKET_NAME: "sam-solace-lab"
  S3_ENDPOINT_URL: "http://agent-mesh-seaweedfs-0.agent-mesh-seaweedfs.sam-solace-lab.svc.cluster.local:8333"
  AWS_ACCESS_KEY_ID: "${AWS_ACCESS_KEY_ID}"
  AWS_SECRET_ACCESS_KEY: "${AWS_SECRET_ACCESS_KEY}"
  AWS_REGION: "us-east-1"

  # --- Artifact content injection into LLM context ---------------------------
  ENABLE_EMBED_RESOLUTION: "true"
  ENABLE_ARTIFACT_CONTENT_INSTRUCTION: "true"
