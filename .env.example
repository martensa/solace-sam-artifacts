# =============================================================================
# Solace Agent Mesh -- Secret values for rendering K8s Secrets
# =============================================================================
#
# Workflow:
#   1. Copy this file:                 cp .env.example .env
#   2. Fill in real values below (ask team lead / retrieve from password vault).
#   3. Render all secret YAMLs:        make secrets
#   4. Apply to the cluster:           make apply-secrets
#
# This file IS committed to git (placeholder values only).
# Your personal `.env` is gitignored -- never commit it.
# =============================================================================

# --- LiteLLM proxy (shared across ALL agents & workflows) --------------------
LLM_SERVICE_API_KEY=sk-REPLACE_ME

# --- Solace broker password (default in dev, replace in production) ----------
SOLACE_BROKER_PASSWORD=default

# --- SeaweedFS / S3-compatible artifact storage (shared default) -------------
AWS_ACCESS_KEY_ID=sam-solace-lab
AWS_SECRET_ACCESS_KEY=sam-solace-lab

# --- Price Comparison Agent optional search backends -------------------------
#
# Each one is inert when left empty. Populate to activate.
# Recommended order (cheapest -> most reliable):
#
#   1) PRICE_BRAVE_API_KEY (free 2000/mo, $5/mo for 50k)
#      - https://brave.com/search/api/
#      - Sidesteps Idealo/Geizhals bot-detection: Brave's backend
#        already aggregates Idealo/Geizhals data. Recommended FIRST.
#
#   2) PRICE_SERPER_API_KEY (free 2500 one-time)
#      - https://serper.dev/
#      - Google Shopping data via Serper's API. Good Brave fallback.
#
#   3) PRICE_APIFY_TOKEN ($5 free credit/mo, ~$5 per 1000 results)
#      - https://apify.com/
#      - Dedicated Idealo + Geizhals scrapers. Use when Brave/Serper
#        coverage is insufficient.
#
#   4) PRICE_SERPAPI_KEY (paid, ~$50/mo for 5000 calls)
#      - https://serpapi.com/
#      - Highest-quality Google Shopping. Use only at scale.
#
# All four can be active simultaneously -- the pipeline queries each
# in parallel and merges results. The Brave key alone solves ~80% of
# the aggregator-bot-detection problem documented as a v1.0 known
# limitation in the Price Comparison Agent README.
PRICE_BRAVE_API_KEY=
PRICE_SERPER_API_KEY=
PRICE_APIFY_TOKEN=
PRICE_SERPAPI_KEY=

# --- EAN Search Agent (ean-search.org API token) -----------------------------
EAN_SEARCH_API_TOKEN=

# --- Datadog MCP Agent -------------------------------------------------------
DD_API_KEY=
DD_APP_KEY=

# --- Solace Broker MCP Agent (SEMP v2 admin credentials) ---------------------
SOLACE_SEMPV2_PASSWORD=admin
