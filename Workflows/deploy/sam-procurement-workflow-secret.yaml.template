# =============================================================================
# Procurement Workflow secret -- workflow-specific overrides only.
# Common values (LLM, Solace, S3) come from `sam-shared-secret`.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  namespace: sam-solace-lab-workflows
  name: sam-procurement-workflow-secret
type: Opaque
stringData:
  LLM_SERVICE_GENERAL_MODEL_NAME: "openai/claude-sonnet-4-6"

  USE_TEMPORARY_QUEUES: "true"

  # --- Workflow session persistence ---
  PERSISTENCE_TYPE: "sql"
  DATABASE_URL: "sqlite:///procurement_workflow.db"
