# =============================================================================
# Web Research Agent secret -- agent-specific overrides only.
# Common values (LLM, Solace, S3) come from `sam-shared-secret`.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  namespace: sam-solace-lab-agents
  name: sam-web-research-agent-secret
type: Opaque
stringData:
  # Opus for deeper research quality (not the default Sonnet).
  LLM_SERVICE_GENERAL_MODEL_NAME: "openai/claude-opus-4-6"

  # --- SearXNG meta-search endpoint (referenced by the agent via SEARXNG_URL env) ---
  SEARXNG_URL: "http://searxng.sam-solace-lab-shared.svc.cluster.local:8080"
