# =============================================================================
# EAN Search Agent secret -- agent-specific overrides + ean-search.org token.
# Common values (LLM, Solace, S3) come from `sam-shared-secret`.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  namespace: sam-solace-lab-agents
  name: sam-ean-search-agent-secret
type: Opaque
stringData:
  LLM_SERVICE_GENERAL_MODEL_NAME: "openai/claude-sonnet-4-6"

  # --- Barcode-database backend ---
  # Choose: "upcitemdb" (free tier 100/day) or "ean_search" (1B+ barcodes, token required)
  EAN_DATABASE_BACKEND: "ean_search"

  # --- ean-search.org settings ---
  # Get token at https://www.ean-search.org/ean-database-api.html
  EAN_SEARCH_API_TOKEN: "${EAN_SEARCH_API_TOKEN}"
  EAN_SEARCH_API_BASE: "https://api.ean-search.org/api"
  EAN_SEARCH_LANGUAGE: "99"

  # --- UPCitemdb settings (active only when EAN_DATABASE_BACKEND=upcitemdb) ---
  UPCITEMDB_API_BASE: "https://api.upcitemdb.com/prod/trial"
  UPCITEMDB_API_KEY: ""

  # --- Shared tuning ---
  EAN_SEARCH_MAX_PAGES: "3"
  EAN_SEARCH_TIMEOUT: "30"
  EAN_SEARCH_MIN_INTERVAL: "0.5"
  EAN_SEARCH_MAX_RETRIES: "1"
  EAN_SEARCH_RETRY_BACKOFF: "2.0"
  EAN_CACHE_TTL: "3600"

  # --- MCP server ---
  MCP_MAX_RESPONSE_CHARS: "25000"
  MCP_LOG_LEVEL: "INFO"
  MCP_LOG_FILE: "ean_search_mcp_server.log"
