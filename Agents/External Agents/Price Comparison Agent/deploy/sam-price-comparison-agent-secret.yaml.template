# =============================================================================
# Price Comparison Agent secret -- agent-specific overrides only.
# Common values (LLM, Solace, S3) come from `sam-shared-secret`.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  namespace: sam-solace-lab-agents
  name: sam-price-comparison-agent-secret
type: Opaque
stringData:
  LLM_SERVICE_GENERAL_MODEL_NAME: "openai/claude-sonnet-4-6"

  # --- SearXNG meta-search (cluster-internal) ---
  PRICE_SEARXNG_URL: "http://searxng.sam-solace-lab-shared.svc.cluster.local:8080"

  # ---------------------------------------------------------------------------
  # Additional structured-shopping search backends (all optional).
  # Each is inert when its key is empty. Populate via .env to activate.
  #
  # Why these matter: Idealo and Geizhals serve HTTP 503/403 to direct
  # browser fetches even with stealth + warmup + per-domain backoff
  # (Phase L+). Brave / Serper / SerpAPI sidestep this entirely --
  # their backends already aggregate Idealo/Geizhals data and return
  # it through a clean API. Apify provides dedicated Idealo/Geizhals
  # scrapers with their own residential-proxy infrastructure when
  # deeper coverage is needed.
  #
  # Recommended activation order (cheapest -> most reliable):
  #   1) SearXNG -- free, cluster-internal, always on
  #   2) Brave Search API   -- free 2000/mo, $5/mo for 50k.
  #      Solves ~80% of the aggregator-bot-detection problem.
  #      Get a key: https://brave.com/search/api/
  #   3) Serper.dev         -- free 2500 one-time. Brave fallback.
  #      Get a key: https://serper.dev
  #   4) Apify              -- $5 free/mo, ~$5 per 1000 results.
  #      Dedicated Idealo + Geizhals actors. https://apify.com
  #   5) SerpAPI            -- paid, ~$50/mo for 5000 calls.
  #      Highest-quality Google Shopping. https://serpapi.com
  # ---------------------------------------------------------------------------
  PRICE_BRAVE_API_KEY: "${PRICE_BRAVE_API_KEY}"
  PRICE_SERPER_API_KEY: "${PRICE_SERPER_API_KEY}"
  PRICE_APIFY_TOKEN: "${PRICE_APIFY_TOKEN}"
  PRICE_SERPAPI_KEY: "${PRICE_SERPAPI_KEY}"

  # --- LLM result-validator pass (final gate before returning offers) ---
  PRICE_LLM_VALIDATOR_ENABLED: "true"
  PRICE_LLM_VALIDATOR_TIMEOUT_SECONDS: "8.0"
  PRICE_LLM_VALIDATOR_MAX_OFFERS: "8"

  # --- Browser settings (Playwright + stealth) ---
  WEB_SCRAPER_HEADLESS: "true"
  WEB_SCRAPER_LOCALE: "de-DE"
  WEB_SCRAPER_TIMEZONE: "Europe/Berlin"
  WEB_SCRAPER_PER_DOMAIN_DELAY_SECONDS: "1.0"
  # Peak context usage = batch_concurrency(3) * inner_concurrent_fetches(3)
  # = 9; +1 for aggregator-SERP resolution, +2 admin reserve -> 12.
  WEB_SCRAPER_MAX_CONTEXTS: "12"
  WEB_SCRAPER_CONTEXT_IDLE_TIMEOUT: "120"
  WEB_SCRAPER_DEFAULT_TIMEOUT_MS: "18000"
  WEB_SCRAPER_NAVIGATION_TIMEOUT_MS: "20000"

  # --- v1.0 category-aware pipeline feature flags ---
  # All default to the code values; set here to override at runtime.
  PRICE_ENABLE_CATEGORIES: "true"
  PRICE_ENABLE_EAN_FASTFAIL: "true"
  PRICE_ENABLE_LOCALE_TEMPLATES: "true"
  PRICE_ENABLE_ANTILEX_GATE: "true"
  # Phase I: SKU/part-number title gate. Forces match_confidence=low
  # whenever the query carries a part-number-shaped token (KSA-S40,
  # MEG6921-0001, ASM-C6A, ...) that is missing from the page title
  # after punctuation normalisation. Catches the Testlauf-3 failure
  # mode where wrong-SKU offers shared the brand but listed sibling
  # part numbers. Set to "false" for emergency rollback.
  PRICE_ENABLE_PART_NUMBER_GATE: "true"
  PRICE_ENABLE_CLASSIFIER_LLM: "true"
  PRICE_CLASSIFIER_LLM_MAX_LATENCY_MS: "3000"
  PRICE_CLASSIFIER_LLM_MIN_CONFIDENCE: "0.5"
  # Phase M: enabled after Testlauf 3 + Phase I validated the cascade.
  # Adds ~400ms to discovery for queries with >=10 candidates but
  # measurably improves URL ranking for ambiguous variant cases like
  # MEPA ellipse vs MEPAorbit. Set to "false" for emergency rollback.
  PRICE_ENABLE_LLM_RERANKER: "true"
  PRICE_ENABLE_DOMAIN_DISCOVERY: "true"
  PRICE_DOMAIN_STATS_DB_PATH: "/app/data/domain_stats.db"
  # Phase P: persist learned-domain table across pod restarts via S3
  # snapshot to SeaweedFS. Bucket / endpoint / credentials come from
  # the shared sam-shared-secret (S3_BUCKET_NAME, S3_ENDPOINT_URL,
  # AWS_*). Restore happens at startup if no local DB yet; uploads are
  # rate-limited to one per minute during active searches.
  PRICE_DOMAIN_STATS_S3_SNAPSHOT: "true"

  # --- Phase F: peer-agent delegation to EANSearchAgent (opt-in) ---
  # When both OpenFoodFacts and Wikidata miss on a valid barcode, the
  # dispatcher can optionally delegate to a SAM peer agent that has
  # paid EAN backends (ean-search.org / UPCitemdb). Disabled by default;
  # flip to "true" AFTER validating EANSearchAgent latency end-to-end.
  PRICE_ENABLE_AGENT_DELEGATION: "false"
  PRICE_SAM_GATEWAY_URL: "http://agent-mesh.sam-solace-lab.svc.cluster.local"
  PRICE_EAN_AGENT_NAME: "EANSearchAgent"
