# =============================================================================
# Price Comparison Agent secret -- agent-specific overrides only.
# Common values (LLM, Solace, S3) come from `sam-shared-secret`.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  namespace: sam-solace-lab-agents
  name: sam-price-comparison-agent-secret
type: Opaque
stringData:
  LLM_SERVICE_GENERAL_MODEL_NAME: "openai/claude-sonnet-4-6"

  # --- SearXNG meta-search (cluster-internal) ---
  PRICE_SEARXNG_URL: "http://searxng.sam-solace-lab-shared.svc.cluster.local:8080"

  # ---------------------------------------------------------------------------
  # Additional structured-shopping search backends (all optional).
  # Each is inert when its key is empty. Populate via .env to activate.
  # Recommended precedence:
  #   1) SearXNG (free, cluster-internal, always on)
  #   2) Brave Search API    (free 2000/mo, https://api.search.brave.com)
  #   3) Serper.dev          (free 2500 one-time, https://serper.dev)
  #   4) SerpAPI             (paid, https://serpapi.com -- best quality)
  #   5) Apify Google Shopping Scraper ($5 free/mo, https://apify.com)
  # ---------------------------------------------------------------------------
  PRICE_SERPAPI_KEY: "${PRICE_SERPAPI_KEY}"
  PRICE_BRAVE_API_KEY: "${PRICE_BRAVE_API_KEY}"
  PRICE_SERPER_API_KEY: "${PRICE_SERPER_API_KEY}"
  PRICE_APIFY_TOKEN: "${PRICE_APIFY_TOKEN}"

  # --- LLM result-validator pass (final gate before returning offers) ---
  PRICE_LLM_VALIDATOR_ENABLED: "true"
  PRICE_LLM_VALIDATOR_TIMEOUT_SECONDS: "8.0"
  PRICE_LLM_VALIDATOR_MAX_OFFERS: "8"

  # --- Browser settings (Playwright + stealth) ---
  WEB_SCRAPER_HEADLESS: "true"
  WEB_SCRAPER_PER_DOMAIN_DELAY_SECONDS: "1.0"
  WEB_SCRAPER_MAX_CONTEXTS: "10"
  WEB_SCRAPER_CONTEXT_IDLE_TIMEOUT: "120"
