# Git
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info
dist/
build/
.venv/
venv/

# Test caches only -- keep `tests/` in the build context so the Dockerfile
# can run `pytest tests/` as a build-gate. The tests folder adds <50KB.
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Documentation (not needed in image)
*.md

# Kubernetes manifests (not needed in image)
deploy/

# IDE
.vscode/
.idea/
.claude/

# Secrets (never include in image)
.env
*.env
secrets/
