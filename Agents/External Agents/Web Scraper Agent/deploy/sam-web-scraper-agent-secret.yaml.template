# =============================================================================
# Web Scraper Agent secret -- agent-specific overrides only.
# Common values (LLM, Solace, S3) come from `sam-shared-secret`.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  namespace: sam-solace-lab-agents
  name: sam-web-scraper-agent-secret
type: Opaque
stringData:
  LLM_SERVICE_GENERAL_MODEL_NAME: "openai/claude-sonnet-4-6"

  # --- Browser settings (Playwright + stealth) ---
  WEB_SCRAPER_HEADLESS: "true"
  WEB_SCRAPER_LOCALE: "de-DE"
  WEB_SCRAPER_TIMEZONE: "Europe/Berlin"
  WEB_SCRAPER_PER_DOMAIN_DELAY_SECONDS: "3"
  WEB_SCRAPER_MAX_CONTEXTS: "3"
  WEB_SCRAPER_STEALTH_ENABLED: "true"

  # --- MCP server ---
  MCP_MAX_RESPONSE_CHARS: "25000"
  MCP_LOG_LEVEL: "INFO"
  MCP_LOG_FILE: "web_scraper_mcp_server.log"
