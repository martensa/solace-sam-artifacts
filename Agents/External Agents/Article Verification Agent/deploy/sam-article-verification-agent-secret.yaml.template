# =============================================================================
# Article Verification Agent secret -- agent-specific overrides only.
# Common values (LLM, Solace, S3) come from `sam-shared-secret`.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  namespace: sam-solace-lab-agents
  name: sam-article-verification-agent-secret
type: Opaque
stringData:
  LLM_SERVICE_GENERAL_MODEL_NAME: "openai/claude-sonnet-4-6"

  # --- MCP server logging ---
  MCP_LOG_LEVEL: "INFO"
  MCP_LOG_FILE: "article_verification_mcp.log"
