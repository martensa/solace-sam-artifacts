# =============================================================================
# Datadog MCP Agent secret -- agent-specific overrides + Datadog credentials.
# Common values (LLM, Solace, S3) come from `sam-shared-secret`.
#
# NOTE: This agent currently uses an older broker VPN ("default") and an
# older S3 bucket ("sam-ent-local"). The overrides below win over shared
# defaults thanks to the envFrom ordering in the Deployment.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  namespace: sam-solace-lab-agents
  name: sam-datadog-mcp-agent-secret
type: Opaque
stringData:
  # Gemini 2.5 Pro or Claude recommended for 73 tools. GPT needs tool subset.
  LLM_SERVICE_GENERAL_MODEL_NAME: "openai/gemini-2.5-pro"

  # --- Overrides of shared values (legacy setup for this agent) ---
  SOLACE_BROKER_VPN: "default"
  S3_BUCKET_NAME: "sam-ent-local"
  AWS_ACCESS_KEY_ID: "sam-ent-local"
  AWS_SECRET_ACCESS_KEY: "sam-ent-local"

  # --- Datadog API credentials ---
  # Get these from https://app.datadoghq.com/organization-settings/api-keys
  DD_API_KEY: "${DD_API_KEY}"
  DD_APP_KEY: "${DD_APP_KEY}"
  # Datadog site: datadoghq.com (US1), datadoghq.eu (EU1), us3/us5, ap1, gov
  DD_SITE: "datadoghq.com"
