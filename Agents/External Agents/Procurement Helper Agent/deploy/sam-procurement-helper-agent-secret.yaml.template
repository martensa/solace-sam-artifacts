# =============================================================================
# Procurement Helper Agent secret -- agent-specific overrides only.
# Common values (LLM, Solace, S3) come from `sam-shared-secret`.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  namespace: sam-solace-lab-agents
  name: sam-procurement-helper-agent-secret
type: Opaque
stringData:
  # The helper agent's LLM is purely a tool router (temperature=0 in
  # the agent config). The same general-purpose model used elsewhere is
  # fine; routing to a named tool with provided JSON args is a trivial
  # task that does not benefit from a stronger model.
  LLM_SERVICE_GENERAL_MODEL_NAME: "openai/claude-sonnet-4-6"

  # --- MCP server logging ---
  MCP_LOG_LEVEL: "INFO"
  MCP_LOG_FILE: "/tmp/procurement_helper_mcp.log"
