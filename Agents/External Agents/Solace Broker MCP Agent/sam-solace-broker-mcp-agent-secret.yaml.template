# =============================================================================
# Solace Broker MCP Agent secret -- agent-specific overrides + SEMP v2 creds.
# Common values (LLM, Solace, S3) come from `sam-shared-secret`.
#
# NOTE: This agent currently uses an older broker VPN ("default") and an
# older S3 bucket ("sam-ent-local"). The overrides below win over shared
# defaults thanks to envFrom ordering in the Deployment.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  namespace: sam-solace-lab-agents
  name: sam-solace-broker-mcp-agent-secret
type: Opaque
stringData:
  # Gemini 2.5 Pro recommended for 456 SEMP v2 tools.
  LLM_SERVICE_GENERAL_MODEL_NAME: "openai/gemini-2.5-pro"

  # --- Overrides of shared values (legacy setup) ---
  SOLACE_BROKER_VPN: "default"
  S3_BUCKET_NAME: "sam-ent-local"
  AWS_ACCESS_KEY_ID: "sam-ent-local"
  AWS_SECRET_ACCESS_KEY: "sam-ent-local"

  # --- SEMPv2 broker admin credentials (for the MCP server) ---
  SOLACE_SEMPV2_BASE_URL: "http://host.docker.internal:8080"
  SOLACE_SEMPV2_AUTH_METHOD: "basic"
  SOLACE_SEMPV2_USERNAME: "admin"
  SOLACE_SEMPV2_PASSWORD: "${SOLACE_SEMPV2_PASSWORD}"

  # --- OpenAPI spec path inside the container ---
  OPENAPI_SPEC: "/opt/solace-broker-mcp-server/semp-v2-swagger-config.json"

  # --- Tool filtering (exclude deprecated endpoints) ---
  MCP_API_EXCLUDE_TAGS: "deprecated"

  # --- MCP server ---
  MCP_LOG_LEVEL: "INFO"
  MCP_LOG_FILE: "solace_broker_mcp_server.log"
