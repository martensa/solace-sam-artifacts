# =============================================================================
# Core Agents secret -- agent-specific overrides only.
# Common values (LLM, Solace, S3) come from `sam-shared-secret`.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  namespace: sam-solace-lab-agents
  name: sam-core-agents-secret
type: Opaque
stringData:
  # --- Model selection (core agents use Opus for planning + general) ---
  LLM_SERVICE_PLANNING_MODEL_NAME: "openai/claude-opus-4-6"
  LLM_SERVICE_GENERAL_MODEL_NAME: "openai/claude-opus-4-6"

  LOGGING_CONFIG_PATH: "configs/logging_config.ini"
